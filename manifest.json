{
  "manifest_version": 3,
  "name": "Download Prefixer",
  "version": "1.3.1",
  "description": "İndirilen dosyaların adına URL'ye göre otomatik prefix ekler",
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Prefixer",
    "default_icon": "icons/icon-32.png"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}